{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    {
      "source": "/((?!api|assets|icons|Cadence_Complete_Documentation\\.pdf|favicon\\.svg|manifest\\.webmanifest|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/lapse-check",
      "schedule": "*/5 * * * *"
    }
  ]
}
