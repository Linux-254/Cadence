# GEMINI_API_KEY: Required for Gemini AI API calls (Search Grounding & Document Summary Cards).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MONGODB_URI: MongoDB Atlas connection string for MERN stack production persistence.
# Leave unset in AI Studio local preview to use automatic local SQLite fallback.
MONGODB_URI=""

# SESSION_SECRET: Optional HMAC secret for signing short-lived access tokens.
SESSION_SECRET=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CRON_SECRET: Optional Bearer secret for /api/cron/lapse-check endpoint (not required yet).
CRON_SECRET=""
